theme = Night Owl
font-family = Menlo
# theme = GruvboxDark
# font-family = Meslo LGS Nerd Font Mono
# font-family = CaskaydiaMono Nerd Font
# font-family = CaskaydiaCove Nerd Font
font-size = 14
background = #00080c
background-opacity = 0.8
background-blur-radius = 0

# Start tmux session automatically (Nix 版 tmux を使う)
command = /run/current-system/sw/bin/tmux new-session

# Tab management keybindings
keybind = ctrl+t=new_tab
keybind = ctrl+q=goto_tab:1
keybind = ctrl+w=goto_tab:2
keybind = ctrl+e=goto_tab:3
keybind = ctrl+r=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8
keybind = ctrl+nine=goto_tab:9

