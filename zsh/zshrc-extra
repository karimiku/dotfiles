# PATH 追加 (各種言語/ツールマネージャ)
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

export PATH="$PATH:$HOME/.lmstudio/bin"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$PATH:$HOME/go/bin"
# NOTE: /opt/homebrew/bin は profileExtra の brew shellenv で先頭に追加済

# dotfiles 運用ショートカット
alias dot='cd ~/dotfiles'
# どのホスト定義を使うかは ~/.zshenv.local の DOTFILES_HOST で切替（既定: mac）
alias drs='sudo darwin-rebuild switch --impure --flake ~/dotfiles#${DOTFILES_HOST:-mac}'  # Nix 設定を反映
alias dru='cd ~/dotfiles && nix flake update && sudo darwin-rebuild switch --impure --flake .#${DOTFILES_HOST:-mac}'  # パッケージ更新

# p10k 設定をロード
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# git worktree 便利関数
gwtnew() {
  local b="$1"
  local dir="${2:-../$(basename "$PWD")-$b}"
  git fetch origin
  git worktree add -b "$b" "$dir"
}

gwtnewcd() {
  local b="$1"
  local dir="${2:-../$(basename "$PWD")-$b}"
  git fetch origin
  git worktree add -b "$b" "$dir" && cd "$dir"
}

gwtaddcd() {
  local b="$1"
  local dir="${2:-../$(basename "$PWD")-$b}"
  git worktree add "$dir" "$b" && cd "$dir"
}

gwtrmp() {
  local dir="$1"
  git worktree remove "$dir" && git worktree prune
}

# NOTE: direnv hook は programs.direnv で自動セット済（home-manager 側）
