# [user] はマシン毎に違う（個人/仕事）ので ~/.gitconfig.local に置く（Nix 管理外）
[include]
	path = ~/.gitconfig.local
[core]
	autocrlf = false
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
